# LiveKit connection settings for dev/start modes (not required in console mode).
LIVEKIT_API_SECRET="<your livekit api secret>"
LIVEKIT_API_KEY="<your livekit api key>"
LIVEKIT_URL="<your livekit ws url>"

# Foundry voice-agent examples: copy this file to .env and fill in the values.
# Authenticate with az login; do not save access tokens here.
# For managed gpt-live-1 (US Data Zone), use a Central US resource and project.
FOUNDRY_PROJECT_ENDPOINT="https://<resource>.services.ai.azure.com/api/projects/<project>"
# For foundry_gpt_live.py, select a saved agent with sub_protocol="live".
# The local get_current_time example uses Responses delegation (the default).
# Declare get_current_time in the saved agent's delegation.responses.tools.
# See livekit-plugins/livekit-plugins-azure/README.md for the matching tool schema.
# Voice, greeting, delegation and tool schemas are saved in Foundry, not this file.
# For foundry_voice_agent.py (realtime/cascade), select sub_protocol="realtime".
AGENT_NAME="<saved-voice-agent-name>"
